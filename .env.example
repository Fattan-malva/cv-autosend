# ── AI Provider Primer: 9Router ──────────────────────────────────────────
# Model: ai-picture (khusus gambar), free-models, atau gpt-4o
9ROUTER_MODEL=ai-picture
# Base URL API 9Router
9ROUTER_API_BASE=https://api.9router.ai/v1
# API Key dari akun 9Router kamu
9ROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ── AI Provider Fallback: Google AI Studio (Gemini) ──────────────────────
# Dipakai otomatis jika 9Router gagal / tidak dikonfigurasi
# Buat API key: https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model: gemma-4-31b-it, gemini-2.0-flash-exp, dll (harus support vision)
GOOGLE_AI_STUDIO_MODEL=gemma-4-31b-it

# ── SMTP Email (wajib untuk kirim email) ──────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SENDER_EMAIL=emailkamu@gmail.com
SENDER_PASSWORD=xxxx xxxx xxxx xxxx
SENDER_NAME=Nama Lengkap Kamu
