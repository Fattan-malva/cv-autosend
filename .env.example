# ── 9Router AI (wajib) ───────────────────────────────────────────────────
# Model: ai-picture (khusus gambar buat di bagian combos), free-models, atau gpt-4o
9ROUTER_MODEL=ai-picture
# Base URL API 9Router (jangan diubah jika tidak tahu)
9ROUTER_API_BASE=https://api.9router.ai/v1
# API Key dari akun 9Router kamu
9ROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ── SMTP Email (wajib untuk kirim email) ──────────────────────────────────
# Contoh untuk Gmail, sesuaikan dengan provider email kamu
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Alamat email pengirim
SENDER_EMAIL=emailkamu@gmail.com
# App Password (bukan password biasa) — lihat README
SENDER_PASSWORD=xxxx xxxx xxxx xxxx
# Nama pengirim yang muncul di email & body surat
SENDER_NAME=Nama Lengkap Kamu
